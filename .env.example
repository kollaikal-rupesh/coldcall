# ColdCall environment variables
# Copy to .env and fill in your keys
# Secret names must use underscores (ALPHA_BETA), not hyphens (ALPHA-beta).

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# OpenAI (LLM)
OPENAI_API_KEY=

# Cartesia (TTS)
CARTESIA_API_KEY=

# LiveKit (optional — coldcall test lk://)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Project secret (Cursor vault / CI) — use ALPHA_BETA, not ALPHA-beta
ALPHA_BETA=
